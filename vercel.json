{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/resolve",
      "destination": "/api/resolve.js"
    },
    {
      "source": "/api/download",
      "destination": "/api/download.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
